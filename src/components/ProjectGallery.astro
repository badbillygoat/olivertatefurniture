---
// Project grid + category filter + modal lightbox. Shared by
// /portfolio (current pieces only) and /archive (every piece).
import { getImage } from 'astro:assets';
import { getProjectImages, isArchived, type Project } from '../lib/projects';

interface Props {
  projects: Project[];
  heading: string;
  intro: string;
  /** When true: cards for archived pieces get an "Archived" tag */
  showArchivedTag?: boolean;
}

const { heading, intro, showArchivedTag = false } = Astro.props;

// Sort: explicit "order" number first (ascending), then by date (newest first)
const projects = [...Astro.props.projects].sort((a, b) => {
  const ao = a.data.order ?? Infinity;
  const bo = b.data.order ?? Infinity;
  if (ao !== bo) return ao - bo;
  return b.data.date.getTime() - a.data.date.getTime();
});

// Parse comma-separated categories from each project
function parseCats(raw: string): string[] {
  return raw.split(',').map(c => c.trim()).filter(Boolean);
}

// Build filter list from all unique categories across all projects
const categories = [
  'all',
  ...[...new Set(projects.flatMap(p => parseCats(p.data.category)))].sort(),
];

// Build project data for modal. Photos are resized at build time: a large
// version for the main stage and a small one for the thumbnail strip, so the
// modal never loads the multi-megabyte originals.
const projectData = Object.fromEntries(
  await Promise.all(
    projects.map(async (p) => {
      const imgs = getProjectImages(p);
      const [large, small] = await Promise.all([
        Promise.all(imgs.map((img) => getImage({ src: img, width: Math.min(img.width, 1600) }))),
        Promise.all(imgs.map((img) => getImage({ src: img, width: Math.min(img.width, 200) }))),
      ]);
      return [
        p.id,
        {
          title:       p.data.title,
          description: p.data.description,
          category:    parseCats(p.data.category).join(', '),
          date:        p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
          materials:   p.data.materials ?? [],
          dimensions:  p.data.dimensions ?? '',
          duration:    p.data.duration ?? '',
          available:   p.data.available,
          images:      large.map((r) => r.src),
          thumbs:      small.map((r) => r.src),
        },
      ];
    })
  )
);
---

  <section class="portfolio-hero section">
    <div class="container">
      <span class="section-label">Work</span>
      <h1 class="section-heading">{heading}</h1>
      <p class="hero-desc">{intro}</p>
      <div class="divider"></div>
    </div>
  </section>

  <section class="portfolio-grid-section">
    <div class="container">

      <!-- Filter tabs -->
      <div class="filter-bar" role="tablist" aria-label="Filter by category">
        {categories.map((cat) => (
          <button
            class="filter-btn"
            role="tab"
            data-category={cat}
            aria-selected={cat === 'all' ? 'true' : 'false'}
          >
            {cat.charAt(0).toUpperCase() + cat.slice(1)}
          </button>
        ))}
      </div>

      <!-- Grid -->
      <ul class="project-grid" role="list">
        {projects.map((project) => (
          <li class="project-card" data-categories={JSON.stringify(parseCats(project.data.category))} data-slug={project.id}>
            <a href={`/portfolio/${project.id}`} class="card-link">
              <div class="card-image-wrap">
                {(() => {
                  const img = getProjectImages(project)[0];
                  return img
                    ? <img src={img.src} alt={project.data.coverAlt ?? project.data.title} loading="lazy" decoding="async" class="card-image" />
                    : <div class="card-image card-no-image" aria-hidden="true" />;
                })()}
                {project.data.featured && (
                  <span class="card-badge">Featured</span>
                )}
                {showArchivedTag && isArchived(project) && (
                  <span class="card-badge card-badge--archived">Archived</span>
                )}
              </div>
              <div class="card-body">
                <span class="card-category">{parseCats(project.data.category).join(', ')}</span>
                <h2 class="card-title">{project.data.title}</h2>
                <p class="card-desc">{project.data.description}</p>
                <div class="card-footer">
                  <span class="card-cta">View project &rarr;</span>
                  {project.data.available && (
                    <span class="card-badge--available">Available</span>
                  )}
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>

    </div>
  </section>

  <!-- Modal — "Side-by-Side": fixed-size photo stage + thumbnails on the left,
       details column on the right. The stage never changes size between
       photos; each photo is fitted inside it. -->
  <div class="modal-backdrop" id="modal-backdrop" aria-modal="true" role="dialog" aria-labelledby="modal-title">
    <div class="modal-panel" id="modal-panel">

      <div class="modal-media">
        <div class="modal-stage">
          <img id="modal-img" src="" alt="" class="modal-img" />
          <button type="button" class="modal-arrow modal-arrow--prev" id="modal-prev" aria-label="Previous photo">&#8249;</button>
          <button type="button" class="modal-arrow modal-arrow--next" id="modal-next" aria-label="Next photo">&#8250;</button>
        </div>
        <div class="modal-thumbs" id="modal-thumbs"></div>
      </div>

      <div class="modal-side" id="modal-side">
        <button type="button" class="modal-close" id="modal-close">Close <span aria-hidden="true">&times;</span></button>
        <span class="modal-category" id="modal-category"></span>
        <h2 class="modal-title" id="modal-title"></h2>
        <div class="divider modal-divider"></div>
        <p class="modal-desc" id="modal-desc"></p>
        <dl class="modal-specs" id="modal-specs"></dl>
        <span class="modal-counter" id="modal-counter"></span>
        <a href="/contact" class="btn btn-primary modal-cta" id="modal-cta" style="display:none;">
          Inquire about this piece
        </a>
      </div>

    </div>
  </div>

<style>
.portfolio-hero {
  padding-block-end: var(--space-8);
}

.hero-desc {
  font-size: var(--text-lg);
  color: var(--color-text-muted);
  max-width: 52ch;
}

/* Filter bar */
.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-block-end: var(--space-10);
}

.filter-btn {
  padding: var(--space-2) var(--space-5);
  font-size: var(--text-sm);
  font-weight: 500;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  background: transparent;
  border: 1.5px solid var(--color-border-dark);
  border-radius: var(--radius-sm);
  color: var(--color-text-muted);
  cursor: pointer;
  transition: background-color var(--transition-fast),
              color var(--transition-fast),
              border-color var(--transition-fast);
}

.filter-btn[aria-selected='true'],
.filter-btn:hover {
  background-color: var(--color-wood);
  border-color: var(--color-wood);
  color: var(--color-warm-white);
}

/* Grid */
.project-grid {
  list-style: none;
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-8);
  padding-block-end: var(--space-16);
}

@media (min-width: 640px) {
  .project-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (min-width: 1024px) {
  .project-grid { grid-template-columns: repeat(3, 1fr); }
}

/* Card */
.project-card {
  background: var(--color-warm-white);
  border: 1px solid var(--color-border-dark);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: box-shadow var(--transition-base), transform var(--transition-base);
}

.project-card:hover {
  box-shadow: var(--shadow-lg);
  transform: translateY(-3px);
}

.project-card[data-hidden] { display: none; }

.card-link {
  display: flex;
  flex-direction: column;
  height: 100%;
  text-decoration: none;
  color: inherit;
  cursor: pointer;
}

.card-image-wrap {
  position: relative;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background-color: var(--color-surface);
}

.card-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--transition-slow);
}

.card-no-image {
  background-color: var(--color-accent);
  opacity: 0.15;
}

.project-card:hover .card-image {
  transform: scale(1.04);
}

.card-badge {
  position: absolute;
  top: var(--space-3);
  right: var(--space-3);
  padding: var(--space-1) var(--space-3);
  background-color: var(--color-wood);
  color: var(--color-warm-white);
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border-radius: var(--radius-sm);
}

/* Sits top-left so it never overlaps the top-right "Featured" badge */
.card-badge--archived {
  right: auto;
  left: var(--space-3);
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-2);
}

.card-footer .card-cta { margin-top: 0; }

.card-badge--available {
  font-family: var(--font-sans);
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-accent);
  border: 1px solid var(--color-accent);
  padding: var(--space-1) var(--space-3);
}

.card-body {
  padding: var(--space-5) var(--space-6) var(--space-6);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  flex: 1;
}

.card-category {
  font-size: var(--text-xs);
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-wood);
}

.card-title {
  font-size: var(--text-xl);
  font-weight: 600;
  color: var(--color-charcoal);
  line-height: var(--leading-snug);
  margin: 0;
}

.card-desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  max-width: none;
  margin: 0;
  flex: 1;
}

.card-cta {
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-wood);
  margin-top: var(--space-2);
  transition: letter-spacing var(--transition-fast);
}

.project-card:hover .card-cta {
  letter-spacing: 0.02em;
}

/* ── Modal (Side-by-Side) ── */
.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 200;
  /* Softened cream veil — the portfolio stays faintly visible behind */
  background: rgba(255, 255, 250, 0.84);
  backdrop-filter: blur(3px);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  overflow-y: auto;
  padding: var(--space-8) var(--space-6);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.modal-backdrop.is-open {
  opacity: 1;
  pointer-events: auto;
}

.modal-panel {
  position: relative;
  width: 100%;
  max-width: 1010px;
  margin: auto;
  background: var(--color-bg);
  border: 1px solid var(--color-accent);
  box-shadow: var(--shadow-lg);
  display: grid;
  grid-template-columns: minmax(0, 1fr) 340px;
  transform: translateY(14px);
  transition: transform 0.3s ease;
}

@media (max-width: 1100px) {
  .modal-panel { grid-template-columns: minmax(0, 1fr) 300px; }
}

.modal-backdrop.is-open .modal-panel {
  transform: translateY(0);
}

/* Photo stage — fixed height, so it never resizes between tall and wide photos */
.modal-media {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

/* Stage height is fixed per piece: it grows only if that piece's details
   column is taller, never when moving between photos. */
.modal-stage {
  position: relative;
  flex: 1 0 auto;
  min-height: min(520px, 64vh);
  background: rgba(79, 65, 51, 0.045);
}

.modal-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: var(--space-8) var(--space-16);
  transition: opacity 180ms ease;
}

.modal-img.is-swapping { opacity: 0; }

.modal-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: var(--space-10);
  height: var(--space-10);
  display: grid;
  place-items: center;
  background: var(--color-bg);
  border: 1px solid var(--color-accent);
  color: var(--color-accent);
  font-size: var(--text-2xl);
  line-height: 1;
  cursor: pointer;
  transition: background-color var(--transition-fast), color var(--transition-fast);
}

.modal-arrow:hover {
  background: var(--color-accent);
  color: var(--color-bg);
}

.modal-arrow--prev { left: var(--space-3); }
.modal-arrow--next { right: var(--space-3); }

/* Thumbnail strip — buttons are created in JS, hence :global */
.modal-thumbs {
  display: flex;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  border-top: 1px solid var(--color-accent);
  overflow-x: auto;
}

.modal-thumbs :global(.modal-thumb) {
  flex: none;
  width: var(--space-16);
  height: var(--space-12);
  padding: 0;
  background: none;
  border: 1px solid transparent;
  cursor: pointer;
  opacity: 0.5;
  transition: opacity var(--transition-fast);
}

.modal-thumbs :global(.modal-thumb img) {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.modal-thumbs :global(.modal-thumb:hover) { opacity: 0.85; }

.modal-thumbs :global(.modal-thumb[aria-current='true']) {
  opacity: 1;
  border-color: var(--color-accent);
  padding: 2px;
}

/* One-photo pieces: no arrows, thumbnails or counter */
.modal-panel.is-single .modal-arrow,
.modal-panel.is-single .modal-thumbs,
.modal-panel.is-single .modal-counter { display: none; }

/* Details column */
.modal-side {
  border-left: 1px solid var(--color-accent);
  padding: var(--space-5) var(--space-8) var(--space-8);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.modal-close {
  align-self: flex-end;
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  background: transparent;
  border: none;
  cursor: pointer;
  font-size: var(--text-xs);
  font-weight: 400;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-accent);
  transition: opacity var(--transition-fast);
}

.modal-close span {
  font-size: var(--text-xl);
  line-height: 1;
  letter-spacing: 0;
}

.modal-close:hover { opacity: 0.6; }

.modal-category {
  display: block;
  font-size: var(--text-xs);
  font-weight: 400;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-accent);
}

.modal-title {
  font-size: var(--text-4xl);
  font-weight: 300;
  line-height: var(--leading-tight);
  text-wrap: balance;
  margin: 0;
}

.modal-divider { margin-block: var(--space-1); }

.modal-desc {
  font-size: var(--text-base);
  line-height: var(--leading-normal);
  margin: 0;
}

.modal-specs {
  display: flex;
  flex-direction: column;
  margin-top: var(--space-1);
}

.modal-specs:empty { display: none; }

.modal-specs :global(.modal-spec-row) {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  padding-block: var(--space-3);
  border-top: 1px solid rgba(79, 65, 51, 0.26);
}

.modal-specs :global(dt) {
  font-size: var(--text-xs);
  font-weight: 400;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(79, 65, 51, 0.72);
}

.modal-specs :global(dd) {
  font-size: var(--text-sm);
  font-weight: 400;
  color: var(--color-accent);
}

.modal-specs :global(ul) {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.modal-specs :global(li::before) { content: '— '; }

.modal-counter {
  margin-top: auto;
  padding-top: var(--space-3);
  font-size: var(--text-xs);
  font-weight: 400;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-variant-numeric: tabular-nums;
  color: rgba(79, 65, 51, 0.72);
}

.modal-cta {
  justify-content: center;
  width: 100%;
  margin-top: var(--space-3);
}

@media (prefers-reduced-motion: reduce) {
  .modal-backdrop, .modal-panel, .modal-img { transition: none; }
}

</style>

<script define:vars={{ projectData }}>
// ── Filter ──────────────────────────────────────────────────────────────
const filterBtns = document.querySelectorAll('.filter-btn');
const cards      = document.querySelectorAll('.project-card');
const allBtn     = document.querySelector('.filter-btn[data-category="all"]');

const selected = new Set();

function applyFilter() {
  cards.forEach((card) => {
    const cardCats = JSON.parse(card.dataset.categories ?? '[]');
    const match = selected.size === 0 || cardCats.some(c => selected.has(c));
    card.toggleAttribute('data-hidden', !match);
  });
}

filterBtns.forEach((btn) => {
  btn.addEventListener('click', () => {
    const cat = btn.dataset.category ?? 'all';

    if (cat === 'all') {
      selected.clear();
      filterBtns.forEach(b => b.setAttribute('aria-selected', 'false'));
      allBtn?.setAttribute('aria-selected', 'true');
    } else {
      allBtn?.setAttribute('aria-selected', 'false');
      if (selected.has(cat)) {
        selected.delete(cat);
        btn.setAttribute('aria-selected', 'false');
      } else {
        selected.add(cat);
        btn.setAttribute('aria-selected', 'true');
      }
      if (selected.size === 0) {
        allBtn?.setAttribute('aria-selected', 'true');
      }
    }

    applyFilter();
  });
});

// ── Modal ────────────────────────────────────────────────────────────────
const backdrop  = document.getElementById('modal-backdrop');
const panel     = document.getElementById('modal-panel');
const closeBtn  = document.getElementById('modal-close');
const modalImg  = document.getElementById('modal-img');
const prevBtn   = document.getElementById('modal-prev');
const nextBtn   = document.getElementById('modal-next');
const thumbsEl  = document.getElementById('modal-thumbs');
const counterEl = document.getElementById('modal-counter');
const catEl     = document.getElementById('modal-category');
const titleEl   = document.getElementById('modal-title');
const descEl    = document.getElementById('modal-desc');
const specsEl   = document.getElementById('modal-specs');
const ctaEl     = document.getElementById('modal-cta');

let currentImages = [];
let currentIndex  = 0;

// Fade the photo out, swap it, fade back in once the new one has loaded
modalImg.addEventListener('load',  () => modalImg.classList.remove('is-swapping'));
modalImg.addEventListener('error', () => modalImg.classList.remove('is-swapping'));

function showImage(index) {
  if (!currentImages.length) return;
  currentIndex = (index + currentImages.length) % currentImages.length;

  const src = currentImages[currentIndex];
  if (modalImg.getAttribute('src') !== src) {
    modalImg.classList.add('is-swapping');
    modalImg.src = src;
  }
  modalImg.alt = titleEl.textContent + ' — photo ' + (currentIndex + 1);

  counterEl.textContent = 'Photo ' + (currentIndex + 1) + ' of ' + currentImages.length;
  thumbsEl.querySelectorAll('.modal-thumb').forEach((t, k) => {
    t.setAttribute('aria-current', String(k === currentIndex));
  });
}

function buildThumbs(thumbs) {
  thumbsEl.replaceChildren();
  thumbs.forEach((src, k) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'modal-thumb';
    btn.setAttribute('aria-label', 'Show photo ' + (k + 1));
    const img = document.createElement('img');
    img.src = src;
    img.alt = '';
    btn.appendChild(img);
    btn.addEventListener('click', () => showImage(k));
    thumbsEl.appendChild(btn);
  });
}

function openModal(slug) {
  const p = projectData[slug];
  if (!p) return;

  // Populate info
  catEl.textContent   = p.category;
  titleEl.textContent = p.title;
  descEl.textContent  = p.description;

  // Build specs
  buildSpecs(specsEl, p);

  // CTA
  ctaEl.style.display = p.available ? '' : 'none';

  // Gallery
  currentImages = p.images;
  panel.classList.toggle('is-single', p.images.length < 2);
  buildThumbs(p.images.length > 1 ? p.thumbs : []);
  showImage(0);

  // Open
  backdrop.scrollTop = 0;
  backdrop.classList.add('is-open');
  document.body.style.overflow = 'hidden';
  // Move keyboard focus into the dialog without drawing a focus ring on open
  closeBtn.focus({ focusVisible: false });
}

function closeModal() {
  backdrop.classList.remove('is-open');
  document.body.style.overflow = '';
  modalImg.removeAttribute('src');
}

function buildSpecs(specsEl, p) {
  specsEl.replaceChildren();

  function addRow(label, content) {
    const row = document.createElement('div');
    row.className = 'modal-spec-row';
    const dt = document.createElement('dt');
    dt.textContent = label;
    const dd = document.createElement('dd');
    if (typeof content === 'string') dd.textContent = content;
    else dd.appendChild(content);
    row.append(dt, dd);
    specsEl.appendChild(row);
  }

  if (p.date)       addRow('Date completed', p.date);
  if (p.dimensions) addRow('Dimensions',     p.dimensions);
  if (p.duration)   addRow('Build time',     p.duration);
  if (p.materials && p.materials.length) {
    const ul = document.createElement('ul');
    p.materials.forEach((m) => {
      const li = document.createElement('li');
      li.textContent = m;
      ul.appendChild(li);
    });
    addRow('Materials', ul);
  }
}

// Card click interception — modal on desktop, navigate on mobile
cards.forEach((card) => {
  const link = card.querySelector('.card-link');
  if (!link) return;
  link.addEventListener('click', (e) => {
    // Mobile: navigate to detail page normally
    // Desktop: open modal
    if (window.innerWidth > 900) {
      e.preventDefault();
      openModal(card.dataset.slug);
    }
  });
});

prevBtn.addEventListener('click', () => showImage(currentIndex - 1));
nextBtn.addEventListener('click', () => showImage(currentIndex + 1));
closeBtn.addEventListener('click', closeModal);

backdrop.addEventListener('click', (e) => {
  if (!panel.contains(e.target)) closeModal();
});

document.addEventListener('keydown', (e) => {
  if (!backdrop.classList.contains('is-open')) return;
  if (e.key === 'Escape') closeModal();
  if (e.key === 'ArrowLeft')  showImage(currentIndex - 1);
  if (e.key === 'ArrowRight') showImage(currentIndex + 1);
});

// Open modal from hero link (e.g. /portfolio#bubinga-maple-tray)
const hash = window.location.hash.slice(1);
if (hash && projectData[hash] && window.innerWidth > 900) {
  openModal(hash);
}
history.replaceState(null, '', window.location.pathname);
</script>
