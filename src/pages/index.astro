---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allProjects = await getCollection('projects');

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{jpg,jpeg,png,webp,avif,gif}',
  { eager: true }
);

function getAllImages(slug: string): ImageMetadata[] {
  return Object.entries(imageModules)
    .filter(([path]) => path.startsWith(`/src/assets/images/${slug}/`))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, mod]) => mod.default);
}

const sorted = allProjects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return b.data.date.getTime() - a.data.date.getTime();
});

const allImages = sorted
  .map((p, pi) => {
    const imgs = getAllImages(p.slug);
    if (imgs.length === 0) return null;
    return {
      img: imgs[0],
      alt: p.data.coverAlt ?? p.data.title,
      slug: p.slug,
      panelSide: pi % 2,
    };
  })
  .filter((x): x is { img: ImageMetadata; alt: string; slug: string; panelSide: number } => x !== null);

const leftImages  = allImages.filter(x => x.panelSide === 0);
const rightImages = allImages.filter(x => x.panelSide === 1);

// ── Zipper geometry ──────────────────────────────────────────────────────────
// The zipper is defined by a PULL POINT (where the two open curves converge and
// the closed seam begins) and a SPINE TILT angle. All coordinates are in % of
// the viewport, matching the SVG viewBox "0 0 100 100" (y increases downward).
//
// Dragging the pull point to the right and tilting the spine makes the whole
// zipper sit at an angle for an asymmetric hero. Each open edge is a cubic
// bezier that leaves the top edge HORIZONTALLY (control point shares y=0) and
// arrives at the pull point leaning ALONG THE SPINE, so the closed seam below
// continues the line rather than kinking. (The pull-tab graphic sits right on
// the join and hides any tiny discontinuity.)

type Pt = [number, number];

function cubicBezierPts(p0: Pt, p1: Pt, p2: Pt, p3: Pt, steps = 24): Pt[] {
  return Array.from({ length: steps + 1 }, (_, i) => {
    const t = i / steps, mt = 1 - t;
    return [
      mt**3*p0[0] + 3*mt**2*t*p1[0] + 3*mt*t**2*p2[0] + t**3*p3[0],
      mt**3*p0[1] + 3*mt**2*t*p1[1] + 3*mt*t**2*p2[1] + t**3*p3[1],
    ] as Pt;
  });
}

// Control points of one open edge: top anchor (topX,0) → pull point.
function edgeCtrl(topX: number, p1x: number, pull: Pt, dDown: Pt, handle: number): [Pt, Pt, Pt, Pt] {
  return [
    [topX, 0],
    [p1x, 0],                                                 // horizontal tangent at top
    [pull[0] - handle * dDown[0], pull[1] - handle * dDown[1]], // tangent along the spine
    [pull[0], pull[1]],
  ];
}

const fmtPt   = ([x, y]: Pt) => `${x.toFixed(2)}% ${y.toFixed(2)}%`;
const svgPath = (c: [Pt, Pt, Pt, Pt]) =>
  `M ${c[0][0].toFixed(2)},${c[0][1].toFixed(2)} C ${c[1][0].toFixed(2)},${c[1][1].toFixed(2)} ` +
  `${c[2][0].toFixed(2)},${c[2][1].toFixed(2)} ${c[3][0].toFixed(2)},${c[3][1].toFixed(2)}`;

interface ZipCfg {
  leftTop: number; rightTop: number; leftP1: number; rightP1: number;
  pull: Pt; tiltDeg: number; handle: number;
}

function buildZipper(cfg: ZipCfg) {
  const th = (cfg.tiltDeg * Math.PI) / 180;
  const dDown: Pt = [Math.sin(th), Math.cos(th)];          // spine direction (downward)
  const spineX = (y: number) => cfg.pull[0] + (y - cfg.pull[1]) * (dDown[0] / dDown[1]);

  const lCtrl = edgeCtrl(cfg.leftTop,  cfg.leftP1,  cfg.pull, dDown, cfg.handle);
  const rCtrl = edgeCtrl(cfg.rightTop, cfg.rightP1, cfg.pull, dDown, cfg.handle);
  const lPts  = cubicBezierPts(...lCtrl);
  const rPts  = cubicBezierPts(...rCtrl);

  const seamBot: Pt = [spineX(100), 100];   // where the seam splits the bottom edge
  const seamEnd: Pt = [spineX(104), 104];   // seam line runs a touch past the bottom

  // Left panel:  top-left corner → left edge → down the seam → bottom-left corner
  const leftPoly = ['0% 0%', ...lPts.map(fmtPt), fmtPt(seamBot), '0% 100%'].join(',');
  // Right panel: right edge → down the seam → bottom-right → top-right corner
  const rightPoly = [...rPts.map(fmtPt), fmtPt(seamBot), '100% 100%', '100% 0%'].join(',');

  // Widest rightward reach of the LEFT region (the seam at the bottom, or the
  // pull point) — the left image track must be this wide to fill it. The right
  // region never reaches left of the pull, so its track stays at a fixed 50%.
  const leftTrackW = Math.max(seamBot[0], cfg.pull[0]) + 1.5;

  return {
    leftPoly, rightPoly, leftTrackW,
    dLeft: svgPath(lCtrl), dRight: svgPath(rCtrl),
    seam: { x1: cfg.pull[0], y1: cfg.pull[1], x2: seamEnd[0], y2: seamEnd[1] },
    pullX: cfg.pull[0], pullY: cfg.pull[1], tiltDeg: cfg.tiltDeg,
  };
}

// Desktop: pull dragged to ~2/3 across, spine tilted for an asymmetric look.
const zipD = buildZipper({
  leftTop: 25, rightTop: 75, leftP1: 46, rightP1: 71,
  pull: [66.67, 83], tiltDeg: 16, handle: 14,
});

// Mobile: wider opening so the wordmark fits; gentler drag + tilt.
const zipM = buildZipper({
  leftTop: 12, rightTop: 88, leftP1: 38, rightP1: 80,
  pull: [60, 83], tiltDeg: 11, handle: 12,
});

const year = new Date().getFullYear();
---

<BaseLayout
  title="Oliver Tate Furniture"
  rawTitle={true}
  description="Oliver Tate Furniture — custom artisan furniture"
  heroLayout={true}
  hideFooter={true}
>

<section class="hero-zipper" aria-label="Oliver Tate Furniture">

  <!-- LEFT IMAGE PANEL -->
  <div class="zipper-panel zipper-panel--left" style={`clip-path: polygon(${zipD.leftPoly})`} aria-hidden="true">
    <div class="panel-track">
      {leftImages.map(({ img, alt, slug }) => (
        <a href={`/portfolio#${slug}`} class="panel-link" tabindex="-1">
          <Image
            src={img}
            alt={alt}
            class="panel-img"
            widths={[800, 1200]}
            sizes="75vw"
            loading="eager"
            decoding="async"
          />
        </a>
      ))}
      {leftImages.map(({ img, slug }) => (
        <a href={`/portfolio#${slug}`} class="panel-link" tabindex="-1">
          <Image src={img} alt="" class="panel-img" widths={[800, 1200]} sizes="75vw" loading="eager" decoding="async" />
        </a>
      ))}
    </div>
  </div>

  <!-- RIGHT IMAGE PANEL -->
  <div class="zipper-panel zipper-panel--right" style={`clip-path: polygon(${zipD.rightPoly})`} aria-hidden="true">
    <div class="panel-track panel-track--right">
      {rightImages.map(({ img, alt, slug }) => (
        <a href={`/portfolio#${slug}`} class="panel-link" tabindex="-1">
          <Image
            src={img}
            alt={alt}
            class="panel-img"
            widths={[800, 1200]}
            sizes="50vw"
            loading="eager"
            decoding="async"
          />
        </a>
      ))}
      {rightImages.map(({ img, slug }) => (
        <a href={`/portfolio#${slug}`} class="panel-link" tabindex="-1">
          <Image src={img} alt="" class="panel-img" widths={[800, 1200]} sizes="50vw" loading="eager" decoding="async" />
        </a>
      ))}
    </div>
  </div>

  <!-- ZIPPER EDGES + CLOSED SEAM (SVG overlay) -->
  <!-- viewBox "0 0 100 100" with preserveAspectRatio="none" maps coordinates
       directly to screen percentages, matching the bezier clip-path above. -->
  <svg
    class="zipper-svg"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <!-- Left curved edge: horizontal tangent at top, along the spine at the pull -->
    <path id="zip-edge-left" class="zip-edge" d={zipD.dLeft} vector-effect="non-scaling-stroke" />
    <!-- Right curved edge -->
    <path id="zip-edge-right" class="zip-edge" d={zipD.dRight} vector-effect="non-scaling-stroke" />
    <!-- Closed seam stitching below the pull tab (tilted along the spine) -->
    <line id="zip-seam" class="zip-seam" x1={zipD.seam.x1} y1={zipD.seam.y1} x2={zipD.seam.x2} y2={zipD.seam.y2} vector-effect="non-scaling-stroke" />
  </svg>

  <!-- PULL TAB at the tip of the V -->
  <div class="zipper-pull" aria-hidden="true"></div>

  <!-- WORDMARK in the open V gap -->
  <div class="zipper-logo">
    <h1 class="hero-wordmark" aria-label="Oliver Tate Furniture">
      <img src="/logos/OT-Logo-black-bold.svg" alt="" class="wm-logo" aria-hidden="true" />
      <span class="wm-oliver" aria-hidden="true">liver</span>
      <span class="wm-furniture" aria-hidden="true">Furniture</span>
      <span class="wm-tate" aria-hidden="true">ate</span>
    </h1>
  </div>

  <!-- Copyright -->
  <div class="hero-copyright" aria-hidden="true">© {year} Oliver Tate Furniture</div>

</section>

<!-- Swap the whole zipper (clip, edges, seam, pull) between the desktop and the
     wider mobile config. Runs immediately to avoid a flash. -->
<script define:vars={{ zipD, zipM }}>
(function () {
  const hero  = document.querySelector('.hero-zipper');
  const lp    = document.querySelector('.zipper-panel--left');
  const rp    = document.querySelector('.zipper-panel--right');
  const edgeL = document.getElementById('zip-edge-left');
  const edgeR = document.getElementById('zip-edge-right');
  const seam  = document.getElementById('zip-seam');
  if (!hero || !lp || !rp) return;

  function apply() {
    const z = window.innerWidth <= 640 ? zipM : zipD;
    lp.style.clipPath = `polygon(${z.leftPoly})`;
    rp.style.clipPath = `polygon(${z.rightPoly})`;
    if (edgeL) edgeL.setAttribute('d', z.dLeft);
    if (edgeR) edgeR.setAttribute('d', z.dRight);
    if (seam) {
      seam.setAttribute('x1', z.seam.x1);
      seam.setAttribute('y1', z.seam.y1);
      seam.setAttribute('x2', z.seam.x2);
      seam.setAttribute('y2', z.seam.y2);
    }
    hero.style.setProperty('--zip-px', z.pullX + '%');
    hero.style.setProperty('--zip-py', z.pullY + '%');
    hero.style.setProperty('--zip-rot', z.tiltDeg + 'deg');
    hero.style.setProperty('--left-track-w', z.leftTrackW + '%');
  }
  apply();
  window.addEventListener('resize', apply, { passive: true });
})();
</script>

</BaseLayout>

<style>
/* ============================================================
   ZIPPER HERO
   ============================================================ */
.hero-zipper {
  /* Pull-tab position + spine tilt. Defaults are the desktop config; the inline
     script overrides these for the mobile config on narrow screens. */
  --zip-px: 66.67%;      /* pull-tab x: ~2/3 across */
  --zip-py: 83%;         /* pull-tab y: 5/6 of screen height */
  --zip-rot: 16deg;      /* spine tilt from vertical */
  --left-track-w: 73%;   /* left image track — wide enough to reach the tilted seam */

  position: relative;
  width: 100%;
  height: 100svh;
  min-height: 560px;
  overflow: hidden;
  background-color: var(--color-bg);
}

/* ---- Image panels — clip-path applied via inline style (computed in frontmatter) ---- */
.zipper-panel {
  position: absolute;
  inset: 0;
}

/* ---- Scrolling image tracks ---- */
.panel-track {
  position: absolute;
  top: 0;
  width: 50%;
  display: flex;
  flex-direction: column;
  will-change: transform;
  animation: driftUp 156.5s linear infinite;   /* 15% faster than the original 180s */
}

/* Left region is the wide side of the tilted zipper, so its track is widened
   (via the script-set var) to reach the seam; the right side stays at 50%. */
.zipper-panel--left  .panel-track { left:  0; width: var(--left-track-w, 73%); }
.zipper-panel--right .panel-track { right: 0; }

.panel-track--right {
  animation-duration: 191.3s;   /* 15% faster than the original 220s */
  animation-delay: -95.65s;     /* start mid-cycle so panels drift out of sync */
}

/* Seamless loop: 2 identical image sets stacked.
   translateY(-50%) = one set height, after which the copy is in
   exactly the same position — so the restart is invisible. */
@keyframes driftUp {
  from { transform: translateY(0); }
  to   { transform: translateY(-50%); }
}

/* Each image links to that piece's popup gallery (/portfolio#slug opens the
   modal there). tabindex=-1 in the markup keeps these decorative, scrolling
   images out of the keyboard tab order. */
.panel-link {
  display: block;
  flex-shrink: 0;
  cursor: pointer;
  transition: opacity var(--transition-fast);
}

.panel-link:hover { opacity: 0.9; }

/* Single border between images creates the separator line. Only one side
   (not both) so adjacent images don't stack two borders into a line twice
   as thick as the zipper seam — this keeps it matching the zip-edge
   stroke-width of 1.5. */
.panel-img {
  width: 100%;
  height: auto;
  display: block;
  border-bottom: 1.5px solid #000;
}

/* ---- SVG zipper-edge overlay ---- */
.zipper-svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
  pointer-events: none;
}

.zip-edge {
  fill: none;
  stroke: #000;
  stroke-width: 1.5;
}

.zip-seam {
  stroke: #000;
  stroke-width: 1;
  stroke-dasharray: 5 4;
}

/* ---- Pull tab ---- */
.zipper-pull {
  position: absolute;
  left: var(--zip-px);
  top: var(--zip-py);
  transform: translate(-50%, -50%) rotate(var(--zip-rot));
  z-index: 4;
  width: 13px;
  height: 20px;
  background: #000;
  border-radius: 2px;
  pointer-events: none;
}

/* ---- Logo in the open V gap ---- */
.zipper-logo {
  position: absolute;
  /* Centered in the OPEN gap, which drifts right + narrows as it descends
     toward the (off-centre) pull point — so this sits right of screen centre. */
  left: 57%;
  top: 18%;
  transform: translate(-50%, -50%);
  z-index: 5;
  pointer-events: none;
  display: flex;
  justify-content: center;
  max-width: 90vw;
}

.hero-wordmark {
  font-family: var(--font-logo);
  font-weight: 400;
  color: #000000;
  letter-spacing: 0.01em;
  animation: fadeUp 1.6s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;
  font-size: clamp(1.5rem, 3.2vw, 3.5rem);
  display: grid;
  grid-template-columns: max-content max-content max-content;
  grid-template-rows: auto auto;
  column-gap: 0;
  row-gap: 0;
  line-height: 1.05;
}

.wm-logo {
  grid-column: 1;
  grid-row: 1 / 3;
  height: 2.1em;
  width: auto;
  display: block;
  margin-top: -0.15em;
}

.wm-oliver {
  grid-column: 2;
  grid-row: 1;
  font-size: 1em;
  align-self: end;
  margin-left: -0.28em;
  margin-top: -0.14em;
}

.wm-tate {
  grid-column: 2;
  grid-row: 2;
  font-size: 1em;
  align-self: start;
  margin-left: -0.38em;
  margin-top: -0.42em;
}

.wm-furniture {
  grid-column: 3;
  grid-row: 1 / 3;
  align-self: end;
  font-size: clamp(1.1rem, 2.3vw, 2.5rem);
  letter-spacing: 0.06em;
  margin-bottom: 0.29em;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ---- Copyright ---- */
.hero-copyright {
  position: absolute;
  bottom: var(--space-4);
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
  font-family: var(--font-sans);
  font-size: var(--text-xs);
  font-weight: 300;
  letter-spacing: 0.1em;
  color: rgba(0, 0, 0, 0.3);
  white-space: nowrap;
  pointer-events: none;
}

/* ---- Mobile: wordmark scaling (clip-path swap is handled by inline script) ---- */
@media (max-width: 640px) {
  .zipper-logo {
    /* Mobile gap drifts right less (gentler tilt, pull at 60%). */
    left: 53%;
    top: 16%;
  }

  .hero-wordmark {
    font-size: clamp(1rem, 5.5vw, 1.8rem);
  }

  .wm-furniture {
    font-size: clamp(0.75rem, 4vw, 1.3rem);
  }
}
</style>
