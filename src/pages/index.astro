---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allProjects = await getCollection('projects');

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{jpg,jpeg,png,webp,avif,gif}',
  { eager: true }
);

function getAllImages(slug: string): ImageMetadata[] {
  return Object.entries(imageModules)
    .filter(([path]) => path.startsWith(`/src/assets/images/${slug}/`))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, mod]) => mod.default);
}

const sorted = allProjects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return b.data.date.getTime() - a.data.date.getTime();
});

const allImages = sorted
  .map((p, pi) => {
    const imgs = getAllImages(p.slug);
    if (imgs.length === 0) return null;
    return {
      img: imgs[0],
      alt: p.data.coverAlt ?? p.data.title,
      panelSide: pi % 2,
    };
  })
  .filter((x): x is { img: ImageMetadata; alt: string; panelSide: number } => x !== null);

const leftImages  = allImages.filter(x => x.panelSide === 0);
const rightImages = allImages.filter(x => x.panelSide === 1);

// ── Zipper geometry ──────────────────────────────────────────────────────────
// Two cubic bezier curves define the zipper edges (in % units matching the SVG
// viewBox 0 0 100 100).  Control points are chosen so that:
//   P1.y = P0.y = 0  →  perfectly HORIZONTAL tangent at the top of each edge
//   P2.x = P3.x = 50 →  perfectly VERTICAL tangent at the pull-tab point
// This gives the "exponential" curve shape: nearly horizontal across the top,
// sweeping steeply inward as it approaches the pull tab.

function cubicBezierPts(
  p0: [number,number], p1: [number,number],
  p2: [number,number], p3: [number,number],
  steps = 24
): [number,number][] {
  return Array.from({ length: steps + 1 }, (_, i) => {
    const t = i / steps, mt = 1 - t;
    return [
      mt**3*p0[0] + 3*mt**2*t*p1[0] + 3*mt*t**2*p2[0] + t**3*p3[0],
      mt**3*p0[1] + 3*mt**2*t*p1[1] + 3*mt*t**2*p2[1] + t**3*p3[1],
    ] as [number, number];
  });
}

const PULL_Y  = 83;   // pull tab at 5/6 of screen height

// Desktop: image panels start at 25% from each edge at the top
const lcD = cubicBezierPts([25, 0], [40, 0], [50, 82], [50, PULL_Y]);
const rcD = cubicBezierPts([75, 0], [60, 0], [50, 82], [50, PULL_Y]);

// Above the pull tab the panels follow the bezier V-curve.
// Below the pull tab they extend to the very bottom of the screen, split
// at x=50% so together they cover the full viewport height.

// Left panel:  top-left corner → bezier → pull point → straight down → bottom-left
const leftPoly = [
  '0% 0%',
  ...lcD.map(([x, y]) => `${x.toFixed(2)}% ${y.toFixed(2)}%`),
  '50% 100%',
  '0% 100%',
].join(',');

// Right panel: bezier (top→pull) → straight down → bottom-right → top-right corner
const rightPoly = [
  ...rcD.map(([x, y]) => `${x.toFixed(2)}% ${y.toFixed(2)}%`),
  '50% 100%',
  '100% 100%',
  '100% 0%',
].join(',');

// Mobile: widen the open gap so the logo fits on narrow screens
const lcM = cubicBezierPts([12, 0], [22, 0], [50, 82], [50, PULL_Y]);
const rcM = cubicBezierPts([88, 0], [78, 0], [50, 82], [50, PULL_Y]);

const leftPolyMobile = [
  '0% 0%',
  ...lcM.map(([x, y]) => `${x.toFixed(2)}% ${y.toFixed(2)}%`),
  '50% 100%',
  '0% 100%',
].join(',');

const rightPolyMobile = [
  ...rcM.map(([x, y]) => `${x.toFixed(2)}% ${y.toFixed(2)}%`),
  '50% 100%',
  '100% 100%',
  '100% 0%',
].join(',');

const year = new Date().getFullYear();
---

<BaseLayout
  title="Oliver Tate Furniture"
  rawTitle={true}
  description="Oliver Tate Furniture — custom artisan furniture"
  heroLayout={true}
  hideFooter={true}
>

<section class="hero-zipper" aria-label="Oliver Tate Furniture">

  <!-- LEFT IMAGE PANEL -->
  <div class="zipper-panel zipper-panel--left" style={`clip-path: polygon(${leftPoly})`} aria-hidden="true">
    <div class="panel-track">
      {leftImages.map(({ img, alt }) => (
        <Image
          src={img}
          alt={alt}
          class="panel-img"
          widths={[800, 1200]}
          sizes="50vw"
          loading="eager"
          decoding="async"
        />
      ))}
      {leftImages.map(({ img }) => (
        <Image src={img} alt="" class="panel-img" widths={[800, 1200]} sizes="50vw" loading="eager" decoding="async" />
      ))}
    </div>
  </div>

  <!-- RIGHT IMAGE PANEL -->
  <div class="zipper-panel zipper-panel--right" style={`clip-path: polygon(${rightPoly})`} aria-hidden="true">
    <div class="panel-track panel-track--right">
      {rightImages.map(({ img, alt }) => (
        <Image
          src={img}
          alt={alt}
          class="panel-img"
          widths={[800, 1200]}
          sizes="50vw"
          loading="eager"
          decoding="async"
        />
      ))}
      {rightImages.map(({ img }) => (
        <Image src={img} alt="" class="panel-img" widths={[800, 1200]} sizes="50vw" loading="eager" decoding="async" />
      ))}
    </div>
  </div>

  <!-- ZIPPER EDGES + CLOSED SEAM (SVG overlay) -->
  <!-- viewBox "0 0 100 100" with preserveAspectRatio="none" maps coordinates
       directly to screen percentages, matching the bezier clip-path above. -->
  <svg
    class="zipper-svg"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <!-- Left curved edge: horizontal tangent at top, vertical at pull tab -->
    <path class="zip-edge" d="M 25,0 C 40,0 50,82 50,83" vector-effect="non-scaling-stroke" />
    <!-- Right curved edge (mirror) -->
    <path class="zip-edge" d="M 75,0 C 60,0 50,82 50,83" vector-effect="non-scaling-stroke" />
    <!-- Closed seam stitching below the pull tab -->
    <line class="zip-seam" x1="50" y1="83" x2="50" y2="104" vector-effect="non-scaling-stroke" />
  </svg>

  <!-- PULL TAB at the tip of the V -->
  <div class="zipper-pull" aria-hidden="true"></div>

  <!-- WORDMARK in the open V gap -->
  <div class="zipper-logo">
    <h1 class="hero-wordmark" aria-label="Oliver Tate Furniture">
      <img src="/logos/OT-Logo-black-bold.svg" alt="" class="wm-logo" aria-hidden="true" />
      <span class="wm-oliver" aria-hidden="true">liver</span>
      <span class="wm-furniture" aria-hidden="true">Furniture</span>
      <span class="wm-tate" aria-hidden="true">ate</span>
    </h1>
  </div>

  <!-- Copyright -->
  <div class="hero-copyright" aria-hidden="true">© {year} Oliver Tate Furniture</div>

</section>

<!-- Mobile: wider V so the wordmark fits. Runs immediately to avoid flash. -->
<script define:vars={{ leftPolyMobile, rightPolyMobile }}>
(function () {
  function applyClip() {
    const lp = document.querySelector('.zipper-panel--left');
    const rp = document.querySelector('.zipper-panel--right');
    if (!lp || !rp) return;
    if (window.innerWidth <= 640) {
      lp.style.clipPath = `polygon(${leftPolyMobile})`;
      rp.style.clipPath = `polygon(${rightPolyMobile})`;
    } else {
      lp.style.clipPath = lp.getAttribute('data-clip-desktop') || '';
      rp.style.clipPath = rp.getAttribute('data-clip-desktop') || '';
    }
  }
  // Store desktop clip so we can restore on resize
  const lp = document.querySelector('.zipper-panel--left');
  const rp = document.querySelector('.zipper-panel--right');
  if (lp) lp.setAttribute('data-clip-desktop', lp.style.clipPath);
  if (rp) rp.setAttribute('data-clip-desktop', rp.style.clipPath);
  applyClip();
  window.addEventListener('resize', applyClip, { passive: true });
})();
</script>

</BaseLayout>

<style>
/* ============================================================
   ZIPPER HERO
   ============================================================ */
.hero-zipper {
  --zip-py: 83%;   /* pull-tab y position: 5/6 of screen */

  position: relative;
  width: 100%;
  height: 100svh;
  min-height: 560px;
  overflow: hidden;
  background-color: var(--color-bg);
}

/* ---- Image panels — clip-path applied via inline style (computed in frontmatter) ---- */
.zipper-panel {
  position: absolute;
  inset: 0;
}

/* ---- Scrolling image tracks ---- */
.panel-track {
  position: absolute;
  top: 0;
  width: 50%;
  display: flex;
  flex-direction: column;
  will-change: transform;
  animation: driftUp 180s linear infinite;
}

.zipper-panel--left  .panel-track { left:  0; }
.zipper-panel--right .panel-track { right: 0; }

.panel-track--right {
  animation-duration: 220s;
  animation-delay: -110s;   /* start mid-cycle so panels drift out of sync */
}

/* Seamless loop: 2 identical image sets stacked.
   translateY(-50%) = one set height, after which the copy is in
   exactly the same position — so the restart is invisible. */
@keyframes driftUp {
  from { transform: translateY(0); }
  to   { transform: translateY(-50%); }
}

/* Thin black border on top+bottom of each image creates a clear
   visual separation between pictures in the panel. */
.panel-img {
  width: 100%;
  height: auto;
  display: block;
  flex-shrink: 0;
  border-top: 1.5px solid #000;
  border-bottom: 1.5px solid #000;
}

/* ---- SVG zipper-edge overlay ---- */
.zipper-svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
  pointer-events: none;
}

.zip-edge {
  fill: none;
  stroke: var(--color-black);
  stroke-width: 1.5;
}

.zip-seam {
  stroke: var(--color-black);
  stroke-width: 1;
  stroke-dasharray: 5 4;
}

/* ---- Pull tab ---- */
.zipper-pull {
  position: absolute;
  left: 50%;
  top: var(--zip-py);
  transform: translate(-50%, -50%);
  z-index: 4;
  width: 13px;
  height: 20px;
  background: var(--color-black);
  border-radius: 2px;
  pointer-events: none;
}

/* ---- Logo in the open V gap ---- */
.zipper-logo {
  position: absolute;
  left: 50%;
  top: 15%;
  transform: translate(-50%, -50%);
  z-index: 5;
  pointer-events: none;
  display: flex;
  justify-content: center;
  max-width: 90vw;
}

.hero-wordmark {
  font-family: var(--font-logo);
  font-weight: 400;
  color: #000000;
  letter-spacing: 0.01em;
  animation: fadeUp 1.6s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;
  font-size: clamp(1.5rem, 3.2vw, 3.5rem);
  display: grid;
  grid-template-columns: max-content max-content max-content;
  grid-template-rows: auto auto;
  column-gap: 0;
  row-gap: 0;
  line-height: 1.05;
}

.wm-logo {
  grid-column: 1;
  grid-row: 1 / 3;
  height: 2.1em;
  width: auto;
  display: block;
  margin-top: -0.15em;
}

.wm-oliver {
  grid-column: 2;
  grid-row: 1;
  font-size: 1em;
  align-self: end;
  margin-left: -0.28em;
  margin-top: -0.14em;
}

.wm-tate {
  grid-column: 2;
  grid-row: 2;
  font-size: 1em;
  align-self: start;
  margin-left: -0.38em;
  margin-top: -0.42em;
}

.wm-furniture {
  grid-column: 3;
  grid-row: 1 / 3;
  align-self: end;
  font-size: clamp(1.1rem, 2.3vw, 2.5rem);
  letter-spacing: 0.06em;
  margin-bottom: 0.29em;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ---- Copyright ---- */
.hero-copyright {
  position: absolute;
  bottom: var(--space-4);
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
  font-family: var(--font-sans);
  font-size: var(--text-xs);
  font-weight: 300;
  letter-spacing: 0.1em;
  color: rgba(0, 0, 0, 0.3);
  white-space: nowrap;
  pointer-events: none;
}

/* ---- Mobile: wordmark scaling (clip-path swap is handled by inline script) ---- */
@media (max-width: 640px) {
  .hero-wordmark {
    font-size: clamp(1rem, 5.5vw, 1.8rem);
  }

  .wm-furniture {
    font-size: clamp(0.75rem, 4vw, 1.3rem);
  }
}
</style>
