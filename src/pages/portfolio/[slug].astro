---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, getProjectImages, isArchived } from '../../lib/projects';

// Detail pages are built for every project, archived ones included, so old
// links keep working. The URL is the project's folder name.
export async function getStaticPaths() {
  const projects = await getProjects({ includeArchived: true });
  return projects.map((project) => ({
    params: { slug: project.id },
    props:  { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const hasBody = Boolean(project.body?.trim());

const projectImages = getProjectImages(project);
const coverImage = projectImages[0] ?? null;

const dateStr = project.data.date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  ogImage={coverImage?.src}
>
  <article class="project-detail">
    <div class="container detail-body">

      <!-- Back link -->
      <a href={isArchived(project) ? '/archive' : '/portfolio'} class="back-link">&larr; All projects</a>

      <!-- "Side-by-Side": fixed-size photo stage + thumbnails, details column.
           Same look as the portfolio pop-up (ProjectGallery.astro). Stacks on phones. -->
      <div class:list={['spread', { 'spread--no-media': projectImages.length === 0 }]}>

        {projectImages.length > 0 && (
          <div class="spread-media" id="detail-gallery">
            <div class="spread-stage">
              {projectImages.map((img, i) => (
                <div class:list={['gallery-slide', { active: i === 0 }]} data-index={i}>
                  <Image
                    src={img}
                    alt={`${project.data.title} — photo ${i + 1}`}
                    class="gallery-img"
                    widths={[800, 1200, 1600]}
                    sizes="(min-width: 900px) 60vw, 100vw"
                    loading="eager"
                  />
                </div>
              ))}
              {projectImages.length > 1 && (
                <>
                  <button type="button" class="gallery-arrow gallery-arrow--prev gallery-prev" aria-label="Previous photo">&#8249;</button>
                  <button type="button" class="gallery-arrow gallery-arrow--next gallery-next" aria-label="Next photo">&#8250;</button>
                </>
              )}
            </div>
            {projectImages.length > 1 && (
              <div class="spread-thumbs">
                {projectImages.map((img, i) => (
                  <button
                    type="button"
                    class="thumb"
                    data-index={i}
                    aria-label={`Show photo ${i + 1}`}
                    aria-current={i === 0 ? 'true' : 'false'}
                  >
                    <Image src={img} alt="" width={160} class="thumb-img" loading="eager" />
                  </button>
                ))}
              </div>
            )}
          </div>
        )}

        <div class="spread-side">
          <span class="section-label">{project.data.category}</span>
          <h1 class="detail-title">{project.data.title}</h1>
          <div class="divider"></div>
          <p class="detail-lead">{project.data.description}</p>

          <dl class="spec-list">
            <div class="spec-row">
              <dt>Date completed</dt>
              <dd>{dateStr}</dd>
            </div>
            {project.data.dimensions && (
              <div class="spec-row">
                <dt>Dimensions</dt>
                <dd>{project.data.dimensions}</dd>
              </div>
            )}
            {project.data.duration && (
              <div class="spec-row">
                <dt>Build time</dt>
                <dd>{project.data.duration}</dd>
              </div>
            )}
            {project.data.materials && project.data.materials.length > 0 && (
              <div class="spec-row">
                <dt>Materials</dt>
                <dd>
                  <ul class="materials-list">
                    {project.data.materials.map((m) => <li>{m}</li>)}
                  </ul>
                </dd>
              </div>
            )}
          </dl>

          {projectImages.length > 1 && (
            <span class="gallery-counter">
              Photo <span id="gallery-current">1</span> of {projectImages.length}
            </span>
          )}

          {project.data.available && (
            <a href="/contact" class="btn btn-primary detail-cta">
              Inquire about this piece
            </a>
          )}
        </div>

      </div>

      <!-- Long description (markdown body), when the .md file has one -->
      {hasBody && (
        <div class="prose detail-prose">
          <Content />
        </div>
      )}

    </div>
  </article>
</BaseLayout>

<style>
/* Body */
.detail-body {
  padding-block: var(--space-10) var(--space-16);
}

.back-link {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-text-muted);
  text-decoration: none;
  margin-block-end: var(--space-6);
  transition: color var(--transition-fast);
}

.back-link:hover { color: var(--color-wood); }

/* ── Spread: bordered frame, stacked on phones, side-by-side from 900px ── */
.spread {
  border: 1px solid var(--color-accent);
  display: grid;
  /* minmax(0, …) stops the thumbnail strip from pushing the frame wider than the screen */
  grid-template-columns: minmax(0, 1fr);
}

@media (min-width: 900px) {
  .spread { grid-template-columns: minmax(0, 1fr) 360px; }
  .spread--no-media { grid-template-columns: 1fr; }
}

.spread-media {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

/* Fixed-shape stage, so it never resizes between tall and wide photos */
.spread-stage {
  position: relative;
  flex: 1 0 auto;
  aspect-ratio: 4 / 3;
  background: rgba(79, 65, 51, 0.045);
}

/* Desktop: grows only if the details column is taller, never between photos */
@media (min-width: 900px) {
  .spread-stage {
    aspect-ratio: auto;
    min-height: min(600px, 70vh);
  }
}

.gallery-slide {
  display: none;
  position: absolute;
  inset: 0;
}

.gallery-slide.active { display: block; }

.gallery-img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: var(--space-4) var(--space-12);
}

@media (min-width: 900px) {
  .gallery-img { padding: var(--space-8) var(--space-16); }
}

.gallery-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
  width: var(--space-10);
  height: var(--space-10);
  display: grid;
  place-items: center;
  background: var(--color-bg);
  border: 1px solid var(--color-accent);
  color: var(--color-accent);
  font-size: var(--text-2xl);
  line-height: 1;
  cursor: pointer;
  transition: background-color var(--transition-fast), color var(--transition-fast);
}

.gallery-arrow:hover {
  background: var(--color-accent);
  color: var(--color-bg);
}

.gallery-arrow--prev { left: var(--space-2); }
.gallery-arrow--next { right: var(--space-2); }

@media (min-width: 900px) {
  .gallery-arrow--prev { left: var(--space-3); }
  .gallery-arrow--next { right: var(--space-3); }
}

/* Thumbnail strip */
.spread-thumbs {
  display: flex;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  border-top: 1px solid var(--color-accent);
  overflow-x: auto;
}

.thumb {
  flex: none;
  width: var(--space-16);
  height: var(--space-12);
  padding: 0;
  background: none;
  border: 1px solid transparent;
  cursor: pointer;
  opacity: 0.5;
  transition: opacity var(--transition-fast);
}

.thumb:hover { opacity: 0.85; }

.thumb[aria-current='true'] {
  opacity: 1;
  border-color: var(--color-accent);
  padding: 2px;
}

.thumb-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Details column */
.spread-side {
  border-top: 1px solid var(--color-accent);
  padding: var(--space-6);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.spread--no-media .spread-side { border-top: none; }

@media (min-width: 900px) {
  .spread-side {
    border-top: none;
    border-left: 1px solid var(--color-accent);
    padding: var(--space-8);
  }
  .spread--no-media .spread-side { border-left: none; }
}

.spread-side .section-label { margin-block-end: 0; }

.detail-title {
  font-size: clamp(var(--text-3xl), 3.2vw, var(--text-5xl));
  text-wrap: balance;
}

.spread-side .divider { margin-block: var(--space-1); }

.detail-lead {
  font-size: var(--text-base);
  line-height: var(--leading-normal);
  margin-block-end: 0;
}

.spec-list {
  display: flex;
  flex-direction: column;
  margin-top: var(--space-1);
}

.spec-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  padding-block: var(--space-3);
  border-top: 1px solid rgba(79, 65, 51, 0.26);
}

.spec-row dt {
  font-size: var(--text-xs);
  font-weight: 400;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(79, 65, 51, 0.72);
}

.spec-row dd {
  font-size: var(--text-sm);
  font-weight: 400;
  color: var(--color-text);
}

.materials-list {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.materials-list li::before { content: '— '; }

.gallery-counter {
  margin-top: auto;
  padding-top: var(--space-3);
  font-size: var(--text-xs);
  font-weight: 400;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-variant-numeric: tabular-nums;
  color: rgba(79, 65, 51, 0.72);
}

.detail-cta {
  justify-content: center;
  width: 100%;
  margin-top: var(--space-3);
}

/* Prose (rendered markdown), below the spread */
.detail-prose {
  margin-top: var(--space-12);
}

.prose {
  color: var(--color-text);
  line-height: var(--leading-normal);
}

.prose :global(h2) {
  font-size: var(--text-2xl);
  margin-block: var(--space-8) var(--space-4);
  color: var(--color-charcoal);
}

.prose :global(h3) {
  font-size: var(--text-xl);
  margin-block: var(--space-6) var(--space-3);
}

.prose :global(p) {
  margin-block-end: var(--space-5);
  max-width: var(--max-width-prose);
}

.prose :global(ul), .prose :global(ol) {
  padding-left: var(--space-6);
  margin-block-end: var(--space-5);
}

.prose :global(li) {
  margin-block-end: var(--space-2);
}

.prose :global(blockquote) {
  border-left: 4px solid var(--color-wood);
  padding-left: var(--space-6);
  color: var(--color-text-muted);
  font-style: italic;
  margin-block: var(--space-6);
}
</style>

<script>
(function () {
  const gallery = document.getElementById('detail-gallery');
  if (!gallery) return;

  const slides    = Array.from(gallery.querySelectorAll('.gallery-slide'));
  const thumbs    = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.thumb'));
  const counterEl = document.getElementById('gallery-current');
  const prevBtn   = gallery.querySelector('.gallery-prev');
  const nextBtn   = gallery.querySelector('.gallery-next');

  if (slides.length < 2) return;

  let current = 0;

  function goTo(index: number) {
    slides[current].classList.remove('active');
    current = (index + slides.length) % slides.length;
    slides[current].classList.add('active');
    if (counterEl) counterEl.textContent = String(current + 1);
    thumbs.forEach((t, k) => t.setAttribute('aria-current', String(k === current)));
  }

  prevBtn?.addEventListener('click', () => goTo(current - 1));
  nextBtn?.addEventListener('click', () => goTo(current + 1));
  thumbs.forEach((t) => t.addEventListener('click', () => goTo(Number(t.dataset.index))));
})();
</script>
