---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';

// Archived pieces (archived: Y) are left out here — they only appear on /archive.
const projects = await getCollection('projects', (p) => !p.data.archived);
---

<BaseLayout
  title="Portfolio"
  description="Browse bespoke furniture by Oliver Tate Furniture — tables, seating, and one-of-a-kind pieces inspired by curves in nature."
>
  <ProjectGallery
    projects={projects}
    heading="Portfolio"
    intro="Every piece is built to order, built to last. Browse recent work below — and reach out if something speaks to you."
  />
</BaseLayout>
