---
// Unlinked archive page — reachable only by typing /archive. Shows every
// project: Projects/Current Portfolio/ and Projects/Archive/. Hidden from
// search engines.
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import { getProjects } from '../lib/projects';

const projects = await getProjects({ includeArchived: true });
---

<BaseLayout
  title="Archive"
  description="The complete archive of work by Oliver Tate Furniture."
  noindex
>
  <ProjectGallery
    projects={projects}
    heading="Archive"
    intro="A complete record of work, including past pieces no longer shown in the portfolio."
    showArchivedTag
  />
</BaseLayout>
